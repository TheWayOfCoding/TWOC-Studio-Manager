{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudioKiosk",
  "version": "0.1.0",
  "identifier": "studio.twoc.kiosk",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:8000/screen/kqc-screen",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Studio Kiosk",
        "url": "http://localhost:8000/screen/kqc-screen",
        "fullscreen": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
