{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twoc-studio-manager/studio-hub/schemas/modality.json",
  "title": "Modality (merged mode/preset/presentation)",
  "type": "object",
  "required": ["label", "beats"],
  "properties": {
    "label": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "enum": ["mode", "preset", "show", "custom"], "default": "custom"},
    "notes": {"type": "string"},
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "label": {"type": "string"},
          "hold_s": {"type": "number", "minimum": 0, "maximum": 3600},
          "stay": {"type": "boolean"},
          "power_delay_s": {"type": "number", "minimum": 0, "maximum": 5},
          "fade_s": {"type": "number", "minimum": 0, "maximum": 60},
          "actions": {
            "type": "object",
            "properties": {
              "powerOn": {"type": "array", "items": {"type": "string"}},
              "powerOff": {"type": "array", "items": {"type": "string"}},
              "lights": {"type": "object"},
              "zoneLights": {"type": "object"},
              "scenes": {"type": "object"},
              "screen": {"type": "object"},
              "obsScene": {"type": ["string", "null"]},
              "obsCollection": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
