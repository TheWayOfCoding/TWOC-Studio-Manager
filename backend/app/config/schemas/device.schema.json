{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twoc-studio-manager/studio-hub/schemas/device.json",
  "title": "Device instance",
  "type": "object",
  "required": ["id", "name", "type", "zone"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "profile": {"type": "string"},
    "name": {"type": "string", "minLength": 1},
    "type": {"type": "string", "minLength": 1},
    "zone": {"type": "string"},
    "powerGroup": {"type": ["string", "null"]},
    "powerPlug": {"type": ["string", "null"]},
    "powerOffPolicy": {"type": "string", "enum": ["auto", "manual-only", "never"], "default": "auto"},
    "bootOrder": {"type": "integer", "minimum": 0},
    "estWatts": {"type": "number", "minimum": 0},
    "controllable": {"type": "boolean", "default": true},
    "driver": {"type": ["string", "null"]},
    "driverAddress": {"type": "object"},
    "position": {"type": "string"},
    "coords": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}}
    },
    "aimedAt": {"type": "string"},
    "distanceToSubjectM": {"type": "number", "minimum": 0},
    "modifiers": {
      "type": "array",
      "description": "Light shapers between the fixture and the subject (softbox, diffusion, grid...). Fed to the AI manifest.",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {"type": "string"},
          "size": {"type": "string"},
          "diffusionLayers": {"type": "integer", "minimum": 0},
          "notes": {"type": "string"}
        }
      }
    },
    "role": {"type": "string"},
    "usual": {"type": "object"},
    "exposure": {"type": "object"},
    "details": {
      "type": "object",
      "description": "Freeform datapoints (multi-word keys welcome), edited on the Equipment page. Fed to the AI manifest.",
      "additionalProperties": {"type": ["string", "number"]}
    }
  },
  "additionalProperties": true
}
